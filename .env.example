# Public browser configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
JOBHUNT_DATA_MODE=supabase

# Server-only Google OAuth configuration. Never expose the client secret publicly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only for local seed tooling and Supabase Edge Functions; never add this key to
# the Cloudflare web Worker. Production bridge calls use the Supabase function.
SUPABASE_SERVICE_ROLE_KEY=

# Optional local knowledge extraction utility key; ChatGPT website tasks use
# the Website Bridge and do not use this key.
OPENAI_API_KEY=

# The ChatGPT Plus website bridge uses a separately paired Supabase Edge
# Function and does not require an OpenAI API key. Configure the extension
# endpoint through JobHuntAI Settings after deploying that function.

# Optional Gmail read-only sync query override
JOBHUNT_GMAIL_SYNC_QUERY=
