# Public browser configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
JOBHUNT_DATA_MODE=supabase

# Server-only Google OAuth configuration. Never expose the client secret publicly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional Gmail read-only sync query override
JOBHUNT_GMAIL_SYNC_QUERY=
