# Public browser configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
JOBHUNT_DATA_MODE=supabase

# Server-only Google OAuth configuration. Never expose the client secret publicly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# Optional server-only direct inspection. When set, Inspect with ChatGPT
# starts an OpenAI Responses API call immediately; otherwise the URL uses the
# connected ChatGPT Task/MCP fallback.
OPENAI_API_KEY=
OPENAI_JOB_INSPECTION_MODEL=gpt-5.4

# Public Google Picker configuration. Restrict the API key to this web origin.
NEXT_PUBLIC_GOOGLE_PICKER_API_KEY=
NEXT_PUBLIC_GOOGLE_CLOUD_PROJECT_NUMBER=

# The ChatGPT Plus website bridge uses a separately paired Supabase Edge
# Function and does not require an OpenAI API key. Configure the extension
# endpoint through Job Hunt Settings after deploying that function.

# Optional Gmail read-only sync query override
JOBHUNT_GMAIL_SYNC_QUERY=
