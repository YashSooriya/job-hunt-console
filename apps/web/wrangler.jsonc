{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "job-hunt-console",
  "main": "custom-worker.ts",
  "workers_dev": true,
  "compatibility_date": "2026-08-23",
  "compatibility_flags": ["nodejs_compat"],
  "limits": {
    "cpu_ms": 30000
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["* * * * *"]
  }
}
