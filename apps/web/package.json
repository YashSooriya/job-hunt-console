{
  "name": "@jobhunt/web",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:job-fit": "node --experimental-default-type=module --experimental-strip-types --test lib/job-fit-v3/*.test.mjs lib/job-fit-memory-v4/*.test.mjs",
    "test:documents": "node --experimental-default-type=module --experimental-strip-types --test lib/document/*.test.mjs",
    "test:chatgpt-bridge": "node --experimental-default-type=module --experimental-strip-types --test lib/chatgpt-bridge/*.test.mjs lib/search/*.test.mjs lib/job-pool*.test.mjs lib/job-fit-memory-v4/*.test.mjs",
    "test:job-pool-sheet": "node --experimental-default-type=module --experimental-strip-types --test lib/application-sheet-contract.test.mjs lib/google-oauth-refresh.test.mjs lib/job-pool*.test.mjs lib/search/job-search-prompt.test.mjs lib/search/manual-search-response.test.mjs",
    "preview:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare deploy -- --keep-vars",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@jobhunt/application-content": "*",
    "@jobhunt/application-preparation": "*",
    "@jobhunt/cv-engine": "*",
    "@jobhunt/email-intelligence": "*",
    "@jobhunt/job-intelligence": "*",
    "@jobhunt/progression-prep": "*",
    "@jobhunt/review-center": "*",
    "@opennextjs/cloudflare": "^1.19.9",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "docx": "9.8.1",
    "fflate": "^0.8.3",
    "next": "^16.3.0",
    "pdf-lib": "1.17.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.0.0",
    "wrangler": "^4.86.0"
  }
}
