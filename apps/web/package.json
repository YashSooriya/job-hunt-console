{
  "name": "@jobhunt/web",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "preview:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare deploy -- --keep-vars",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "next": "^16.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "@jobhunt/job-intelligence": "*",
    "@jobhunt/application-preparation": "*",
    "@jobhunt/cv-engine": "*",
    "@jobhunt/application-content": "*",
    "@jobhunt/review-center": "*",
    "@jobhunt/email-intelligence": "*",
    "@jobhunt/progression-prep": "*",
    "@opennextjs/cloudflare": "^1.19.9"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.0.0",
    "wrangler": "^4.86.0"
  }
}
